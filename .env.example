# Copy to .env and fill in.  The retrieval stack runs with NO keys;
# only grounded answer generation (and the LLM judge) needs an Anthropic key.

# --- LLM (generation + LLM-as-judge) ---
ANTHROPIC_API_KEY=
GEN_MODEL=claude-sonnet-5
JUDGE_MODEL=claude-sonnet-5

# --- Embeddings ---
# auto: use sentence-transformers if importable, else TF-IDF fallback
EMBED_BACKEND=auto
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Reranking ---
# auto: use CrossEncoder if importable, else a lexical reranker
RERANK_BACKEND=auto
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Retrieval knobs ---
CHUNK_TOKENS=220
CHUNK_OVERLAP=40
RRF_K=60
TOP_K_BM25=40
TOP_K_DENSE=40
TOP_K_RERANK=8

# --- Storage ---
# sqlite   : zero-infra default (FTS5 BM25 + NumPy cosine)
# postgres : production (tsvector BM25 + pgvector HNSW); needs requirements-pg.txt
DB_BACKEND=sqlite
DB_PATH=storage/corpus.db
PG_DSN=postgresql://postgres:postgres@localhost:55432/rag
